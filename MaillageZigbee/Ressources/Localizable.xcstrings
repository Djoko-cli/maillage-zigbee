        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Names, rooms and floors (zones) come from the Home app, read by Passeur Noms; the Hue bridge gives addresses, connection state and batteries. The reading is redone at launch when it is more than a day old."
          }
        },
        "fr" : {
